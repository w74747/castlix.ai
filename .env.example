# ===== إلزامي =====
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=            # معرّفات المصرح لهم مفصولة بفواصل (أرسل /whoami للبوت لمعرفة معرّفك)
ADMIN_CHAT_ID=               # تصلك عليه تقارير التكلفة والأخطاء

# ===== اختياري (غياب المفتاح يعطّل مرحلته فقط) =====
TAVILY_API_KEY=
GAMMA_API_KEY=               # يتطلب خطة Gamma تتيح API
LLAMA_CLOUD_API_KEY=
PERPLEXITY_API_KEY=          # غير مستخدم حالياً

# ===== ضبط =====
MARKET_SEARCH_DEPTH=basic            # basic | advanced (الأخير أغلى)
MARKET_BILINGUAL=1                   # استعلام إنجليزي + عربي
MARKET_INCLUDE_DOMAINS=              # مثال: ncsi.gov.om,cbo.gov.om (نطاقات موثوقة مفصولة بفواصل)
GAMMA_EXPORT_AS=                     # pdf | pptx | (فارغ)
GAMMA_USD_PER_CREDIT=                # ضع سعر الكريدت من خطتك ليظهر في تقارير التكلفة
PERSISTENCE_PATH=/data/castlix_state.pkl   # اربط Volume في Railway على /data
COST_LOG_PATH=/data/costs.jsonl
